# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
# No trailing slash: a skill may hold a *symlink* to an ext4 venv, and a
# directory-only rule would not ignore the symlink itself.
.venv
venv/
env/
ENV/
.env/
.agent-reach-venv/
container-site-packages/

# Runtime log artifacts (graph-memory digest hooks)
**/digest/log/
**/log/

# Package & Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# C / C++ build outputs
*.o
*.obj
*.d
*.a
*.lib
*.so
*.dylib
*.exe
*.out

# Rust build outputs
target/
Cargo.lock

# Node / Web
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secret & Environmental Credentials
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx

# Operating System & Editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.Trash-*

# Databases & Ephemeral Indexes
*.db
*.sqlite
*.sqlite3
rag.db

# Private & Personal Data
university-notes/
University/

# Generated flat discovery layout (sync-skills builds it from the root links).

# video-miner stage workspaces: raw frame evidence is reproducible from the
# source video with `video-miner`, so the ledger and context stay in git and
# the 100 MB of PNG crops do not.
**/[0-9][0-9]_*/crops/
**/[0-9][0-9]_*/stills/

# Emitted by `omnicli harness verify` on every run.
orchestration/omnicli/harnesses/verification_report.html

# cf-architect probe cache (read-only account snapshot, machine-local).
.cloudflare/
